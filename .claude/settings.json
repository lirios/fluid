{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 .agents/hooks/check_license_header_claude.py",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 .agents/hooks/audit_license_header_claude.py",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 .agents/hooks/qmlformat_claude.py",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
