{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 .claude/hooks/check-license-header.py",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 .claude/hooks/audit-license-header.py",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "if [[ \"$CLAUDE_TOOL_INPUT_FILE_PATH\" == *.qml ]]; then qmlformat --inplace --newline unix --semicolon-rule always \"$CLAUDE_TOOL_INPUT_FILE_PATH\" 2>/dev/null || true; fi",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}