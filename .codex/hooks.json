{
    "description": "MPL-2.0 SPDX license header enforcement, ported from .github/hooks",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "^apply_patch$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 .agents/hooks/check_license_header_codex.py",
                        "statusMessage": "Checking license headers",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "^apply_patch$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 .agents/hooks/audit_license_header_codex.py",
                        "statusMessage": "Auditing license headers",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "^apply_patch$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 .agents/hooks/qmlformat_codex.py",
                        "statusMessage": "Formatting QML files",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
