{
    "description": "MPL-2.0 SPDX license header enforcement, ported from .github/hooks",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "^apply_patch$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 .codex/hooks/check-license-header.py",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "^apply_patch$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 .codex/hooks/audit-license-header.py",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "^apply_patch$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "git diff --name-only --diff-filter=ACMR -z | while IFS= read -r -d '' file; do case \"$file\" in *.qml) qmlformat --inplace --newline unix --semicolon-rule always \"$file\" 2>/dev/null || true ;; esac; done",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}