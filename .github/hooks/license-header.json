{
    "hooks": {
        "PreToolUse": [
            {
                "type": "command",
                "command": "python3 .github/hooks/check-license-header.py",
                "timeout": 10
            }
        ],
        "PostToolUse": [
            {
                "type": "command",
                "command": "python3 .github/hooks/audit-license-header.py",
                "timeout": 10
            }
        ]
    }
}